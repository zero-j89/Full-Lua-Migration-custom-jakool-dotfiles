# Hypridle
# Original config submitted by https://github.com/SherLock707

$iDIR="$HOME/.config/swaync/images/ja.png"

general {
    lock_cmd = pidof hyprlock || hyprlock # runs hyprlock if it is not already running
    # unlock_cmd = killall hyprlock # kills hyprlock when unlocking
    before_sleep_cmd = loginctl lock-session # ensures that the session is locked before going to sleep
    after_sleep_cmd = hyprctl dispatch dpms on # turn on screen after sleep / wake
    ignore_dbus_inhibit = false # respect dbus idle inhibitors (used by video players, games, etc.)
}

# turn off screen faster if session is already locked
