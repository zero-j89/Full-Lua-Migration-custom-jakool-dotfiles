# Warn
listener {
    timeout = 900 # 15 min
    on-timeout = notify-send -i $iDIR " You are idle!" # command to run when timeout has passed
    on-resume = notify-send -i $iDIR " Oh hey fuckface! you're Back" # command to run when activity is detected after timeout has fired
}

# Screenlock
listener {
    timeout = 1800 # 30 min
    on-timeout = loginctl lock-session # locks the session after 30 minutes idle
    on-resume = notify-send -i $iDIR "You better be ZeR0, System Unlocked!" # optional notification after activity resumes
}

# Turn off screen
listener {
    timeout = 3600 # 60 min
    on-timeout = hyprctl dispatch dpms off # turns off the screen after timeout has passed
    on-resume = hyprctl dispatch dpms on # turns the screen back on when activity is detected
}

